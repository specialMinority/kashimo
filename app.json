{
  "expo": {
    "name": "kashimo",
    "slug": "kashimo",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "kashimo",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/branding/mascot.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F3EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kashimo.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon.png",
        "backgroundColor": "#F6F3EC"
      },
      "package": "com.kashimo.app",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/branding/icon.png",
      "display": "standalone",
      "backgroundColor": "#F6F3EC",
      "themeColor": "#F6F3EC",
      "description": "カシモ — 友だちとの貸し借りを、やさしく記録。",
      "startUrl": "./",
      "meta": {
        "apple": {
          "mobile-web-app-capable": "yes",
          "mobile-web-app-status-bar-style": "black-translucent"
        }
      }
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-file-system",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": false,
      "baseUrl": "/kashimo"
    },
    "extra": {
      "eas": {
        "projectId": "368c4b30-3f68-4481-bcec-13c341156ab8"
      }
    }
  }
}
