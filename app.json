{
  "expo": {
    "name": "kashimo",
    "slug": "kashimo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kashimo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4ECDC4"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kashimo.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4ECDC4"
      },
      "package": "com.kashimo.app",
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png",
      "display": "standalone",
      "backgroundColor": "#4ECDC4",
      "themeColor": "#4ECDC4",
      "description": "Kashimo - P2P Finance Manager for Friends",
      "startUrl": "/",
      "meta": {
        "apple": {
          "mobile-web-app-capable": "yes",
          "mobile-web-app-status-bar-style": "black-translucent"
        }
      }
    },
    "plugins": [
      "expo-font",
      "expo-sqlite",
      "expo-file-system"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "368c4b30-3f68-4481-bcec-13c341156ab8"
      }
    }
  }
}